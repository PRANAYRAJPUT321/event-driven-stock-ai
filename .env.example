# ── Required ────────────────────────────────────────────────────────────────
# Supabase is the only service this app cannot run without: it provides auth
# and the database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Optional ────────────────────────────────────────────────────────────────
# With a key, event classification and the bull/bear narrative are written by
# Claude. Without one — or if the key is out of credit, rate-limited or
# revoked — the app falls back to the deterministic engine in
# lib/ai/ruleClassifier.ts and keeps working. Nothing breaks if this is unset.
ANTHROPIC_API_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── No key needed ───────────────────────────────────────────────────────────
# Market data (Yahoo Finance), crypto (CoinGecko) and news (Google News and
# Yahoo RSS) are all fetched from keyless public endpoints. There is nothing
# to configure for them, and no NewsAPI or Twelve Data key is used any more.
